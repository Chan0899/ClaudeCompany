# ============================================================
# 多Claude协同系统 - 环境配置模板
# 复制此文件为 .env 后修改实际值
# ============================================================

# Claude CLI 使用的模型版本
CLAUDE_MODEL=claude-sonnet-4-6

# CrewAI 执行模式: sequential | parallel
CREWAI_PROCESS=sequential

# Flask 服务配置
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# AI 运行模式: simulated | claude
AI_MODE=claude
